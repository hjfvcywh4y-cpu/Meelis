# Переменные окружения MLM Academy.
# Файл содержит только имена. Реальные значения задаются в локальном .env.local
# или в переменных окружения площадки развёртывания и никогда не коммитятся.

# Предпросмотр каталога: показывает все 112 карточек, включая неопубликованные.
# Включать только на закрытых стендах. В production должно отсутствовать или быть false.
ENABLE_CATALOG_PREVIEW=

# Служебный экран /admin/catalog в production. По умолчанию доступен только в dev
# или вместе с включённым предпросмотром.
ENABLE_ADMIN_CATALOG=

# Внешняя витрина (например, страница на Tilda). Необязательно.
NEXT_PUBLIC_SHOWCASE_URL=

# Серверный rerank поиска. Только на площадке, никогда в Tilda и клиентском JS.
OPENAI_API_KEY=
# Альтернатива OpenAI:
GROQ_API_KEY=
SEARCH_RERANK_MODEL=gpt-4o-mini
SEARCH_RERANK_ENDPOINT=
# Публичный URL proxy после деплоя. Попадает в HEAD Tilda, ключ — нет.
MLMA_RERANK_PUBLIC_URL=

# Account API. Публичный URL можно в HEAD Tilda. Секрет сессии — только Worker.
MLMA_API_PUBLIC_URL=
MLMA_SESSION_SECRET=

# Supabase Auth. Пока не подключено. Не выдумывать и не класть в Tilda.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MLMA_WEBHOOK_SECRET=
PAYMENT_GATEWAY=test

# Платежи выключены. ЮKасса и Supabase не подключаются в этой итерации.
PAYMENTS_ENABLED=false
COMMERCE_PREVIEW_ENABLED=false
TEST_MODE=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Маршрутная архитектура v2. В production payments/paid nav/bypass принудительно false.
TRACK_REGISTRY_ENABLED=true
ROUTE_ENGINE_ENABLED=true
PAID_TRACK_NAVIGATION_ENABLED=false
ALLOW_DRAFT_RULES=false
ADMIN_PREVIEW_ENABLED=true
ENTITLEMENT_BYPASS=false
REGISTERED_BETA_ACCESS_ENABLED=true
# Production storage: PostgreSQL. In-memory is tests/CLI only.
# If NODE_ENV=production and DATABASE_URL is empty, architecture API fail-closes (503).
# Do not set MLMA_ARCHITECTURE_STORE=memory in production.
# Account Worker beta runtime uses KV, not SQL.
MLMA_ARCHITECTURE_STORE=
DATABASE_URL=

