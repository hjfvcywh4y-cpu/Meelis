  "aiPolicy": {
    "aiRequired": false,
    "sendToAi": [],
    "note": "A3-008 is deterministic. No external AI call is needed to classify or route an outcome."
  },
  "stripPolicy": {
    "rejectUnknownFields": true,
    "stripBeforeLogs": true,
    "stripBeforeAnalytics": true,
    "stripBeforePersistence": true,
    "opaqueContactCardRefRequired": true
  },
  "ethicalRules": [
    "An explicit refusal terminates persuasion; it is not converted into an objection-handling branch.",
    "A later contact requires explicit permission and a date.",
    "Silence creates waiting, not consent.",
    "A referral route requires permission; referral PII stays on the client.",
    "The source phrase about gaining a moral right to dictate conditions is deliberately excluded as incompatible with freedom of choice."
  ]
}
