    "duration_bucket",
    "record_status",
    "lock_reason"
  ],
  "logDeniedFields": [
    "contact_name",
    "phone",
    "email",
    "messenger_handle",
    "profile_url",
    "message_text",
    "response_text",
    "call_transcript",
    "exact_words",
    "free_text_note",
