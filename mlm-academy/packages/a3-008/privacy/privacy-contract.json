    "wait_until",
    "retry_count",
    "stop_code",
    "idempotency_key",
    "supersedes_outcome_id",
    "route_decision_id"
  ],
  "clientOnlyFields": [
    "contact_name",
    "phone",
    "email",
    "messenger_handle",
    "profile_url",
    "message_text",
    "response_text",
    "call_transcript",
