{
  "version": "1.0",
  "principle": "Полная карточка повода принадлежит пользователю и остаётся локально; сервер получает только структурированный outcome для маршрутизации.",
  "serverAllowedFields": [
    "track_id",
    "content_version",
    "outcome_code",
    "real_reason",
    "fact_source_code",
    "intent_code",
    "disclosure_status",
    "timing_code",
    "permission_status",
    "contact_allowed",
    "no_reason_code",
    "review_trigger_code",
    "stop_code",
    "risk_flag_codes",
    "ai_used",
    "ai_advisory_codes",
    "route_decision_id",
    "occurred_at"
  ],
  "clientOnlyFields": [
    "contact_name",
    "phone",
    "email",
    "messenger_handle",
    "profile_url",
    "company_name",
    "real_reason_text",
    "fact_text",
    "why_this_person_text",
    "why_now_text",
    "opener_draft",
    "message_draft",
    "conversation_quote",
    "free_text_note",
    "contact_card"
  ],
  "analyticsAllowedFields": [
    "track_id",
    "content_version",
    "outcome_code",
    "real_reason",
    "fact_source_code",
    "intent_code",
    "disclosure_status",
    "timing_code",
    "permission_status",
    "no_reason_code",
    "review_trigger_code",
    "stop_code",
    "risk_flag_codes",
    "ai_used",
    "ai_advisory_codes",
    "destination_type",
    "destination_id",
    "duration_bucket"
  ],
  "ai": {
    "defaultMode": "STRUCTURED_REVIEW",
    "defaultFreeTextTransmission": false,
    "optionalSanitizedTextMode": "explicit consent + preview + transient no-log gateway",
    "originalDraftNeverTransmittedAutomatically": true
  },
  "redaction": [
    "names",
    "phones",
    "emails",
    "handles",
    "profile URLs",
    "company names where identifying",
    "exact quotes",
    "health facts",
    "financial facts",
    "private events"
  ],
  "storageRules": [
    "No contact-level free text in server persistence.",
    "No client-only field in logs, traces, analytics or error reporting.",
    "Local handoff to A3-002 uses the user device context; only route facts reach the server.",
    "Public demo uses fixed synthetic examples and never accepts real contact details."
  ]
}
