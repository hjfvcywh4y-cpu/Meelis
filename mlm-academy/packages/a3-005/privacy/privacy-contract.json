{
  "version": "1.0",
  "trackId": "A3-005",
  "serverAllowedFields": [
    "track_id",
    "content_version",
    "outcome_code",
    "appointment.status",
    "appointment.explicit_confirmation",
    "appointment.starts_at",
    "appointment.timezone",
    "appointment.duration_minutes",
    "appointment.format_code",
    "appointment.topic_code",
    "appointment.calendar_action_code",
    "appointment.followup_allowed",
    "appointment.review_anchor_code",
    "appointment.review_at",
    "appointment.decision_source_code",
    "appointment.no_followup_reason_code",
    "risk_flag_codes",
    "ai_used",
    "ai_advisory_codes",
    "route_decision_id",
    "occurred_at"
  ],
  "clientOnlyFields": [
    "contact_name",
    "phone",
    "email",
    "messenger_handle",
    "profile_url",
    "company_name",
    "contact_card",
    "topic_text",
    "location_text",
    "meeting_link",
    "counterpart_availability_text",
    "slot_label_text",
    "invitation_draft",
    "confirmation_text",
    "conversation_quote",
    "free_text_note",
    "calendar_title",
    "calendar_description",
    "attendee_data"
  ],
  "analyticsAllowedFields": [
    "track_id",
    "content_version",
    "outcome_code",
    "appointment.status",
    "appointment.explicit_confirmation",
    "appointment.timezone_region",
    "appointment.duration_minutes",
    "appointment.format_code",
    "appointment.topic_code",
    "appointment.calendar_action_code",
    "appointment.followup_allowed",
    "appointment.review_anchor_code",
    "appointment.decision_source_code",
    "appointment.no_followup_reason_code",
    "risk_flag_codes",
    "ai_used",
    "ai_advisory_codes",
    "destination_type",
    "destination_id",
    "duration_bucket"
  ],
  "stripUnsafeFacts": true,
  "rules": [
    "Server may store appointment mechanics needed for routing and a personal reminder: status, time, timezone, duration, format and topic code.",
    "Counterparty identity, phone, email, meeting link, location text, invitation copy and conversation remain client-only.",
    "No attendee is added and no external invite is sent by this package.",
    "Exact starts_at and review_at are operational data but excluded from analytics; analytics may use only coarse duration and region.",
    "AI receives structured codes by default; sanitized text is transient and requires explicit consent."
  ]
}
